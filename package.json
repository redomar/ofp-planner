{
  "name": "ofp-planner",
  "version": "1.4.1",
  "description": "Pick a real airline flight for your sim and send it to SimBrief. Static, client-only.",
  "author": {
    "name": "Mohamed Omar",
    "url": "https://github.com/redomar"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "predev": "pnpm copy-assets",
    "dev": "next dev",
    "prebuild": "pnpm copy-assets",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "data:snapshot": "node scripts/snapshot/index.mjs",
    "map:terrain": "node scripts/build-terrain.mjs",
    "data:push": "bash scripts/push-data.sh"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "flag-icons": "^7.5.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "d3-array": "^3.2.4",
    "d3-contour": "^4.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "world-atlas": "^2.0.2"
  }
}
